# Copy to .env.local for local builds. All values are optional: without them the
# app runs in demo mode (sample bins, no sign-in).
#
# Firebase web config (safe to expose to browsers - protect data with Firestore
# rules, not with these values).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: override the basemap style (default is OpenFreeMap "dark").
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

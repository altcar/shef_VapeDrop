{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vapedrop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "preview_urls": true,
  "vars": {
    "ROUTING_PROVIDER": "valhalla"
  }
}

{
  "name": "vapedrop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "VapeDrop — find a vape recycling bin near you, get a walking route, earn rewards.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
